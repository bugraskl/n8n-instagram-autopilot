# Overlay layout, sourced by scripts/render_one.sh when it exists at <data_dir>/assets/layout.env.
# Values are pixels on the final canvas. The defaults below match the reference overlays;
# change them to fit YOUR overlay artwork. See docs/overlay-spec.md.
# (Colours and the font come from the Config node of the workflow, not from here.)

POST_W=2304                   # 4:5 feed post
POST_H=2880
POST_OVERLAY=post_overlay.png # transparent PNG in assets/
POST_DISH_TOP=912             # top edge of the product line: fixed anchor, the slogan grows upward from here
POST_GAP=44                   # gap between the slogan and the product line
POST_SLOGAN_H=104             # optical height of one slogan line
POST_DISH_H=120               # optical height of the product line
POST_LOGO_BOTTOM=700          # bottom edge of your logo: the slogan never goes above it (the block moves down instead)

STORY_W=2160                  # 9:16 story
STORY_H=3840
STORY_OVERLAY=story_overlay.png
STORY_DISH_TOP=964
STORY_GAP=30
STORY_SLOGAN_H=104
STORY_DISH_H=156
STORY_LOGO_BOTTOM=810
